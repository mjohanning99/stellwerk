# Copy this file to .env and replace the values with your own:
#   cp .env.example .env
#   id -u; id -g; echo "$USER"
#
# The container runs as this user and group, so files the agents write stay
# yours. Bash doesn't export UID and has no GID, which is why they live here.
UID=1000
GID=1000
USER=me

# Your home folder. Compose normally takes it from your shell; set it here
# only if you start compose from somewhere HOME isn't set.
# HOME=/home/me

# Optional. The defaults match a normal install.
# STELLWERK_HOST=127.0.0.1
# STELLWERK_PORT=7777
# STELLWERK_ALLOWED_HOSTS=
# STELLWERK_PROXY_ORIGINS=.ts.net
