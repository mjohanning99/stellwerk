# Copy this file to .env and replace the values with your own, or write it in
# one go:
#   printf 'UID=%s\nGID=%s\nHOST_USER=%s\nHOST_HOME=%s\n' "$(id -u)" "$(id -g)" "$USER" "$HOME" > .env
#
# The container runs as this user and group, so files the agents write stay
# yours. These live here, not in your shell, so `sudo docker compose` (which
# sets HOME=/root and USER=root) still runs Stellwerk as you.
UID=1000
GID=1000
HOST_USER=me
HOST_HOME=/home/me

# Optional. The defaults match a normal install.
# STELLWERK_HOST=127.0.0.1
# STELLWERK_PORT=7777
# STELLWERK_ALLOWED_HOSTS=
# STELLWERK_PROXY_ORIGINS=.ts.net
